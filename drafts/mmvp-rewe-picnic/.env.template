# Picnic credentials — register at https://picnic.app (NL/DE only)
PICNIC_EMAIL=
PICNIC_PASSWORD=
PICNIC_COUNTRY=de

# REWE location — choose DELIVERY (by PLZ) or PICKUP (by market ID)
# Option A: delivery to your postal code (recommended)
REWE_SERVICE_TYPE=DELIVERY
REWE_ZIP_CODE=

# Option B: pickup from a specific store
# REWE_SERVICE_TYPE=PICKUP
# REWE_MARKET_ID=
# REWE_ZIP_CODE=

# REWE mTLS certificate (required for prices)
# Run:  python3 setup-rewe-cert.py   (needs REWE APK or connected Android device)
REWE_CERT_FILE=rewe.pem
REWE_KEY_FILE=rewe.key

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=
