    { "from": "promotions", "to": "order_scheduler", "label": "discounts", "async": false },
    { "from": "shopping_carts", "to": "savings_display", "label": "promo alerts", "async": true },
    { "from": "favourite_products", "to": "savings_display", "label": "favourites", "async": false },
    { "from": "products_db", "to": "name_normalisation", "label": "", "async": false },
