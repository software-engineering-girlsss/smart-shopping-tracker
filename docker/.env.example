# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Database ---
POSTGRES_PASSWORD=change_me_in_production

# --- REWE ---
# Service mode: DELIVERY (recommended) or PICKUP
REWE_SERVICE_TYPE=DELIVERY
# German postal code for delivery/store lookup
REWE_ZIP_CODE=10115
# mTLS cert files (run backend/setup-rewe-cert.py to generate)
REWE_CERT_FILE=./certs/rewe.pem
REWE_KEY_FILE=./certs/rewe.key

# --- Picnic ---
# Register at picnic.app (Germany)
PICNIC_EMAIL=your@email.com
PICNIC_PASSWORD=yourpassword
PICNIC_COUNTRY=de

# --- OpenAI (for AI product matching) ---
# Get a free key at: https://platform.openai.com/api-keys
# Leave blank to use stub matching (first candidate wins)
OPENAI_API_KEY=

# --- Certs volume ---
# Directory containing rewe.pem and rewe.key
CERTS_DIR=./certs
