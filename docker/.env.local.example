# Local Docker setup (plain docker run, no Compose)
# cp docker/.env.local.example docker/.env.local

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=url
SPRING_DATASOURCE_USERNAME=planer
SPRING_DATASOURCE_PASSWORD=localpass

APP_REWE_SERVICE_TYPE=DELIVERY
APP_REWE_ZIP_CODE=
APP_REWE_CERT_FILE=
APP_REWE_KEY_FILE=

APP_PICNIC_EMAIL=
APP_PICNIC_PASSWORD=
APP_PICNIC_AUTH_TOKEN=
APP_PICNIC_COUNTRY=de

APP_OPENAI_API_KEY=

# AES-256-GCM key for encrypting Picnic credentials at rest.
# Generate with: openssl rand -base64 32
# Must be a base64-encoded 32-byte (256-bit) key. REQUIRED in production.
APP_ENCRYPTION_KEY=
APP_SUPABASE_URL=
APP_SUPABASE_ANON_KEY=
APP_SUPABASE_SERVICE_KEY=
APP_INVITE_TOKENS=

APP_FRONTEND_URL=

# Password for /actuator/prometheus, /actuator/metrics etc. (HTTP Basic Auth).
# Set the same value in Render dashboard env vars.
APP_MANAGEMENT_PASSWORD=
